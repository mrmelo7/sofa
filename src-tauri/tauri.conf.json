{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sofa",
  "version": "../package.json",
  "identifier": "com.sofa.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sofa",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#0b0d12",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data:",
        "font-src": "'self' data:",
        "media-src": "'self' https: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https:"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "packaging/**/*",
      "../dist/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMEM5M0EyNTZDNkIyRTcKUldUbnNzWldvcE1Nb3ZCekZwUm9XbCtiTkJYdGlxNUdLNlNlcURyTSthR2Ixb3BUUEF6NnhGR1QK",
      "endpoints": [
        "https://github.com/elionaimelo/sofa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
